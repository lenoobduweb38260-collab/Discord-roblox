# ⚙️ Configuration du Dashboard web — remplissez directement CE fichier
# (ou définissez ces variables dans le panneau de votre hébergeur : elles priment).

# ================== CONNEXION DISCORD (OAuth2) ==================
# Portail développeur Discord > votre application > OAuth2 :
#  - Client ID (= Application ID)
DASH_CLIENT_ID=
#  - Client Secret (bouton « Reset Secret » si besoin)
DASH_CLIENT_SECRET=

# URL PUBLIQUE du dashboard, sans / final (ex : http://191.44.119.37:43700
# ou https://dashboard.mondomaine.fr). Ajoutez « CETTE URL + /callback » dans
# Portail développeur > OAuth2 > Redirects (ex : http://191.44.119.37:43700/callback)
DASH_URL=

# Port du dashboard (souvent imposé/alloué par l'hébergeur web)
DASH_PORT=43700

# ================== LIEN AVEC VOS BOTS ==================
# L'agent hébergeur multi-bots (pack-hebergeur.zip) déjà en place :
AGENT_URL=http://191.44.119.37:9999
AGENT_KEY=
