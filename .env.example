# Token du bot (Portail développeur Discord > Bot > Token)
DISCORD_TOKEN=votre_token_ici

# ID de l'application (Portail développeur Discord > General Information > Application ID)
CLIENT_ID=votre_client_id_ici

# Optionnel : ID du serveur pour déployer les commandes instantanément sur UN serveur.
# Laissez vide pour un déploiement global (peut prendre jusqu'à 1h).
GUILD_ID=
