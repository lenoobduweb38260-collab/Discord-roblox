# Token du bot (Portail développeur Discord > Bot > Token)
DISCORD_TOKEN=votre_token_ici

# ID de l'application (Portail développeur Discord > General Information > Application ID)
CLIENT_ID=votre_client_id_ici

# Optionnel : ID du serveur pour déployer les commandes instantanément sur UN serveur.
# Laissez vide pour un déploiement global (peut prendre jusqu'à 1h).
GUILD_ID=

# Optionnel : ID Discord du propriétaire du bot (créateur). Utilisé notamment
# pour la réponse IA supervisée (le bot vous envoie ses réponses en MP).
OWNER_ID=

# Optionnel : réponse IA supervisée. Clé API Anthropic (console.anthropic.com).
# Sans cette clé, la fonctionnalité est simplement inactive.
AI_API_KEY=
# Modèle IA à utiliser (par défaut claude-sonnet-5).
AI_MODEL=
