# ⚙️ Configuration de l'AGENT (partagée) — remplissez directement CE fichier
# (ou définissez ces variables dans le panneau de votre hébergeur : elles priment).
#
# 🤖 Les bots, eux, se configurent CHACUN dans leur dossier : bots/<nom>/config.env
# (créé automatiquement — remplissez-le depuis l'onglet ⚙️ .env de votre panel).

# 🔑 OBLIGATOIRE : clé d'accès de l'agent — inventez une longue clé secrète.
# C'est elle que vous saisirez dans votre panel pour relier vos bots
# (la même URL + la même clé servent pour TOUS vos bots).
AGENT_KEY=changez-moi-cle-secrete

# Port de l'agent (souvent imposé/alloué par l'hébergeur)
AGENT_PORT=43600

# Dépôt GitHub d'où viennent les mises à jour du code des bots
UPDATE_REPO=lenoobduweb38260-collab/Discord-roblox
